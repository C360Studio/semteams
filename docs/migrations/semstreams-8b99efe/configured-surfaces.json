                    "mode": "reconcile",
                    "predicates": [
                      "autoresearch.run.status"
                    ]
                  },
                  {
                    "name": "iteration-pending",
                    "mode": "reconcile",
                    "predicates": [
                      "autoresearch.iteration.pending"
                    ]
                  }
                ]
              }
            ]
          }
        },
        "teams-loop": {
          "factory": "agentic-loop",
          "type": "processor",
          "enabled": true,
          "declarations": {
            "ports": {
              "inputs": [
                {
                  "name": "agent.task",
                  "required": true,
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "AGENT",
                    "subjects": [
                      "agent.task.*"
                    ]
                  },
                  "description": "Agent task requests"
                },
                {
                  "name": "agent.response",
                  "required": true,
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "AGENT",
                    "subjects": [
                      "agent.response.>"
                    ]
                  },
                  "description": "Model responses"
                },
                {
                  "name": "tool.result",
                  "required": true,
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "TOOL",
                    "subjects": [
                      "tool.result.>"
                    ]
                  },
                  "description": "Tool execution results"
                },
                {
                  "name": "agent.approval_response",
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "AGENT",
                    "subjects": [
                      "agent.approval_response.*"
                    ]
                  },
                  "description": "Human approve/reject/modify decisions (ADR-053 \u00a74c PR-2). The loop's setupSubscriptions routes this port to handleApprovalResponseMessage \u2192 ResolveApprovalIfPending, which un-parks the gated loop. WITHOUT this declared input the loop never subscribes and can NEVER resume from an approval gate. Also drives the approvalpause subscriber's run-phase resume marker."
                }
              ],
              "outputs": [
                {
                  "name": "agent.request",
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "AGENT",
                    "subjects": [
                      "agent.request.*"
                    ]
                  },
                  "description": "Model requests"
                },
                {
                  "name": "tool.execute",
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "TOOL",
                    "subjects": [
                      "tool.execute.*"
                    ]
                  },
                  "description": "Tool execution requests"
                },
                {
                  "name": "agent.complete",
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "AGENT",
                    "subjects": [
                      "agent.complete.*"
                    ]
                  },
                  "description": "Task completions"
                },
                {
                  "name": "agent.failed",
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "AGENT",
                    "subjects": [
                      "agent.failed.*"
                    ]
                  },
                  "description": "Loop failures \u2014 drives the chainpause subscriber (ADR-037 \u00a7D5 audit triples). Retires alongside chainpause in ADR-042 \u00a7Phase 6 migration cut; until then, declaring the port keeps the bootstrap canonical."
                },
                {
                  "name": "agent.approval_pending",
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "AGENT",
                    "subjects": [
                      "agent.approval_pending.*"
                    ]
                  },
                  "description": "Tool-gate approval-pending events \u2014 drives the approvalpause subscriber (ADR-053 \u00a74c: run-phase reflection of the loop-level approval_required gate). Declaring the port keeps the subject covered by the AGENT stream so PublishToStream succeeds and lets portresolver resolve the subscribe subject."
                },
                {
                  "name": "loops",
                  "config": {
                    "kind": "kv-write",
                    "bucket": "AGENT_LOOPS"
                  },
                  "description": "Canonical loop authority storage"
                }
              ]
            }
          }
        },
        "agentic-model": {
          "factory": "agentic-model",
          "type": "processor",
          "enabled": true,
          "declarations": {
            "ports": {
              "inputs": [
                {
                  "name": "agent.request",
                  "required": true,
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "AGENT",
                    "subjects": [
                      "agent.request.>"
                    ]
                  },
                  "description": "Agent request input"
                }
              ],
              "outputs": [
                {
                  "name": "agent.response",
                  "required": true,
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "AGENT",
                    "subjects": [
                      "agent.response.*"
                    ]
                  },
                  "description": "Agent response output"
                }
              ]
            }
          }
        },
        "agentic-tools": {
          "factory": "agentic-tools",
          "type": "processor",
          "enabled": true,
          "declarations": {
            "ports": {
              "inputs": [
                {
                  "name": "tool.execute",
                  "required": true,
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "TOOL",
                    "subjects": [
                      "tool.execute.>"
                    ]
                  },
                  "description": "Tool execution requests"
                },
                {
                  "name": "entity_states",
                  "config": {
                    "kind": "kv-read",
                    "bucket": "ENTITY_STATES"
                  },
                  "description": "Entity state KV for graph queries"
                }
              ],
              "outputs": [
                {
                  "name": "tool.result",
                  "required": true,
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "TOOL",
                    "subjects": [
                      "tool.result.*"
                    ]
                  },
                  "description": "Tool execution results"
                }
              ]
            },
            "allowed_tools": null,
            "restricted_decide_actions": []
          }
        },
        "teams-dispatch": {
          "factory": "agentic-dispatch",
          "type": "processor",
          "enabled": true,
          "declarations": {
            "ports": {
              "inputs": [
                {
                  "name": "user.message",
                  "required": true,
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "USER",
                    "subjects": [
                      "user.message.>"
                    ]
                  },
                  "description": "User messages from any channel",
                  "external": true
                },
                {
                  "name": "agent.complete",
                  "required": true,
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "AGENT",
                    "subjects": [
                      "agent.complete.*"
                    ]
                  },
                  "description": "Loop completions \u2014 drives the coordinator's wake-up reply path"
                }
              ],
              "outputs": [
                {
                  "name": "agent.task",
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "AGENT",
                    "subjects": [
                      "agent.task.*"
                    ]
                  },
                  "description": "Task messages to agent loops"
                },
                {
                  "name": "user.response",
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "USER",
                    "subjects": [
                      "user.response.>"
                    ],
                    "interface": {
                      "type": "agentic.user_response",
                      "version": "v1"
                    }
                  },
                  "description": "Typed responses back to users; channel routers fan out to UI/email/SMS"
                },
                {
                  "name": "agent.approval_response",
                  "config": {
                    "kind": "jetstream",
                    "stream_name": "AGENT",
                    "subjects": [
                      "agent.approval_response.*"
                    ]
                  },
                  "description": "Approve/reject/modify decisions published by POST /teams-dispatch/loops/{id}/approval (ADR-053 \u00a74c PR-2). Declared so PublishToStream is AGENT-stream-covered, ResolveSubject resolves the subject, and the AGENT stream carries agent.approval_response.* for the teams-loop consumer + the approvalpause resume subscriber."
                }
              ]
            },
            "default_tools": [
              "decide",
              "read_loop_result",
              "scratchpad",
              "query_sandbox_attestation",
              "request_sandbox"
            ],
            "permissions": {
              "view": [
                "*"
              ],
              "submit_task": [
                "*"
              ],
              "cancel_own": true,
              "cancel_any": [],
              "approve": [
                "*"
              ]
            }
          }
        },
        "graph-gateway": {
          "factory": "graph-gateway",
          "type": "gateway",
          "enabled": true,
          "declarations": {
            "ports": {
              "outputs": [
                {
                  "name": "graph_queries",
                  "required": true,
                  "config": {
                    "kind": "nats-request",
                    "subject": "graph.query.*",
                    "interface": {
                      "type": "graph.query",
                      "version": "v1"
                    }
                  }
                },
                {
                  "name": "graph_index_queries",
                  "required": true,
                  "config": {
                    "kind": "nats-request",
                    "subject": "graph.index.query.*"
                  }
                },
                {
                  "name": "agentic_queries",
                  "required": true,
                  "config": {
                    "kind": "nats-request",
                    "subject": "agentic.query.*",
                    "interface": {
                      "type": "agentic.query",
                      "version": "v1"
                    }
                  }
                }
              ]
            }
          }
        },
        "objectstore": {
          "factory": "objectstore",
          "type": "storage",
          "enabled": true,
          "declarations": {}
        }
      },
      "configured_services": {
        "service-manager": {
          "enabled": true
        },
        "component-manager": {
          "enabled": true
        },
        "metrics": {
          "enabled": true
        },
        "message-logger": {
          "enabled": true
        },
        "log-forwarder": {
          "enabled": true
        },
        "metrics-forwarder": {
          "enabled": true
        }
      }
    }
  }
}
