{
  "id": "autoresearch_reviewer_approved_to_coordinator",
  "type": "expression",
  "name": "Approved autoresearch reviewer \u2192 durable run result",
  "description": "A successful terminal reviewer records its full loop entity ID on the run and retains the existing success outcome. The completed-run rule forwards this immutable result to the actual origin coordinator, whose native parent/run route delivers the answer. Iteration state stays on the run; no route is invented on that non-loop entity.",
  "enabled": true,
  "entity": {
    "pattern": "*.*.agentic-loop.agent.execution.*"
  },
  "conditions": [
    {
      "field": "agent.loop.role",
      "operator": "eq",
      "value": "reviewer-autoresearch",
      "required": true
    },
    {
      "field": "coordinator.decision.next-action",
      "operator": "eq",
      "value": "approved",
      "required": true
    },
    {
      "field": "agent.loop.outcome",
      "operator": "eq",
      "value": "success",
      "required": true
    },
    {
      "field": "agent.lineage.run-loop-entity-id",
      "operator": "length_eq",
      "value": 1,
      "required": true
    }
  ],
  "logic": "and",
  "on_enter": [
    {
      "type": "add_triple",
      "subject": "$entity.triple.agent.lineage.run-loop-entity-id",
      "predicate": "autoresearch.reply.approved",
      "object": "$entity.id"
    },
    {
      "type": "add_triple",
      "subject": "$entity.triple.agent.lineage.run-loop-entity-id",
      "predicate": "agent.run.outcome",
      "object": "success"
    }
  ],
  "on_exit": [],
  "metadata": {
    "pack": "autoresearch",
    "actor": "reviewer-autoresearch",
    "contract": "origin-loop reply handoff",
    "result": "approved",
    "adr": "docs/adr/029-product-shell-wiring.md"
  }
}
