{
  "version": "1.1.0",
  "platform": {
    "org": "c360",
    "id": "semteams-bootstrap-e2e",
    "type": "agentic-e2e",
    "region": "local",
    "instance_id": "bootstrap-e2e-001",
    "environment": "test"
  },
  "tier": "agentic",
  "nats": {
    "urls": [
      "nats://localhost:4222"
    ]
  },
  "streams": {
    "USER": {
      "subjects": ["user.>"],
      "storage": "file",
      "max_age": "1h"
    }
  },
  "model_registry": {
    "endpoints": {
      "general": {
        "provider": "openai",
        "url": "http://mock-llm:8080/v1",
        "model": "mock-model",
        "max_tokens": 16384,
        "supports_tools": true,
        "tool_format": "openai",
        "stream": true
      },
      "fast": {
        "provider": "openai",
        "url": "http://mock-llm:8080/v1",
        "model": "mock-model",
        "max_tokens": 8192,
        "supports_tools": true,
        "tool_format": "openai",
        "stream": false
      }
    },
    "defaults": {
      "model": "general"
    },
    "capabilities": {
      "coordinator": { "preferred": ["general"], "requires_tools": true },
      "research": { "preferred": ["general"], "fallback": ["fast"], "requires_tools": true },
      "reviewing": { "preferred": ["general"], "fallback": ["fast"], "requires_tools": true },
      "general": { "preferred": ["general"], "fallback": ["fast"], "requires_tools": true },
      "claude-haiku": { "preferred": ["general"], "fallback": ["fast"], "requires_tools": true }
    }
  },
  "services": {
    "service-manager": {
      "name": "service-manager",
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemTeams Bootstrap",
          "description": "Substrate-singleton boot config per ADR-042 §Phase 2 redesign. Agentic + graph + rule-processor components run as singletons; task-category rule packs and named persona bundles run through them. No chain-specific configuration here.",
          "version": "0.7.0"
        }
      }
    },
    "component-manager": {
      "name": "component-manager",
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "name": "metrics",
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics",
        "include_go_metrics": true
      }
    },
    "message-logger": {
      "name": "message-logger",
      "enabled": true,
      "config": {
        "max_entries": 10000,
        "monitor_subjects": [
          "agent.>",
          "tool.>",
          "user.>",
          "graph.mutation.>"
        ],
        "enable_kv_query": true,
        "log_level": "INFO"
      }
    },
    "log-forwarder": {
      "name": "log-forwarder",
      "enabled": true,
      "config": {
        "min_level": "DEBUG",
        "exclude_sources": []
      }
    },
    "metrics-forwarder": {
      "name": "metrics-forwarder",
      "enabled": true,
      "config": {
        "push_interval": "5s",
        "include_go_metrics": false,
        "include_proc_metrics": false
      }
    }
  },
  "components": {
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "graph_mutations",
              "subject": "graph.mutation.>",
              "type": "nats",
              "description": "Triple add/remove mutations from agent emit tools, rules, and operator-side subscribers"
            }
          ],
          "outputs": [
            {
              "name": "entity_states",
              "subject": "ENTITY_STATES",
              "type": "kv-write",
              "description": "Entity state KV bucket"
            }
          ]
        },
        "enable_hierarchy": true
      }
    },
    "graph-query": {
      "type": "processor",
      "name": "graph-query",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {"name": "query_requests", "subject": "graph.query.>", "type": "nats-request"}
          ],
          "outputs": []
        },
        "request_timeout": "30s",
        "max_traversal_depth": 5,
        "max_traversal_nodes": 100
      }
    },
    "rule": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "entity_watch_patterns": [
          "c360.>"
        ],
        "ports": {
          "inputs": [
            {
              "name": "entity_states",
              "subject": "ENTITY_STATES.>",
              "type": "kv-watch",
              "bucket": "ENTITY_STATES",
              "description": "Entity state changes drive rule evaluation. Rule conditions resolve against entity facts (agent.loop.role, coordinator.decision.next_action, etc.), not raw NATS messages — the message-path evaluator can't bind entity-typed predicates."
            }
          ],
          "outputs": [
            {
              "name": "agent_task",
              "subject": "agent.task.*",
              "type": "jetstream",
              "stream_name": "AGENT",
              "description": "Agent task triggers from rules"
            },
            {
              "name": "graph_mutation",
              "subject": "graph.mutation.*",
              "type": "nats",
              "description": "Graph triple mutations from rule add_triple actions"
            }
          ]
        },
        "enable_graph_integration": true,
        "rules_files": [
          "/app/configs/rules/research/01-coordinator-research-spawn.json",
          "/app/configs/rules/research/02-plan-to-gather.json",
          "/app/configs/rules/research/03a-gather-stamp-completion-on-plan.json",
          "/app/configs/rules/research/03b-synthesize-when-all-gathers-complete.json",
          "/app/configs/rules/research/04-synthesize-to-reviewer.json",
          "/app/configs/rules/research/05-reviewer-rejected-retry.json",
          "/app/configs/rules/research/06-needs-clarification-replan.json",
          "/app/configs/rules/research/07-reviewer-approved-to-coordinator.json",
          "/app/configs/rules/research/08-loop-failed-pause.json",
          "/app/configs/rules/dev-via-test/01-coordinator-dev-via-test-spawn.json",
          "/app/configs/rules/dev-via-test/02-lisa-terminal-to-plan-review.json",
          "/app/configs/rules/dev-via-test/02b-plan-approved-to-coordinator.json",
          "/app/configs/rules/dev-via-test/02c-plan-retry-stamp.json",
          "/app/configs/rules/dev-via-test/02d-plan-retry-driver.json",
          "/app/configs/rules/dev-via-test/02e-plan-rejected-to-coordinator.json",
          "/app/configs/rules/dev-via-test/02f-lisa-needs-clarification-to-coordinator.json",
          "/app/configs/rules/dev-via-test/03-coordinator-dispatch-ralph.json",
          "/app/configs/rules/dev-via-test/04a-execute-stamp-converged.json",
          "/app/configs/rules/dev-via-test/04b-execute-stamp-failed.json",
          "/app/configs/rules/dev-via-test/05-ralph-terminal-to-coordinator.json",
          "/app/configs/rules/dev-via-test/06-coordinator-dispatch-cbg.json",
          "/app/configs/rules/dev-via-test/07a-cbg-approved-to-coordinator.json",
          "/app/configs/rules/dev-via-test/07b-cbg-rejected-to-coordinator.json",
          "/app/configs/rules/dev-via-test/07c-cbg-retry-stamp.json",
          "/app/configs/rules/dev-via-test/07d-cbg-retry-driver.json",
          "/app/configs/rules/dev-via-test/07e-cbg-retry-missing-target.json",
          "/app/configs/rules/dev-via-test/08-loop-failed-pause.json",
          "/app/configs/rules/autoresearch/01-coordinator-autoresearch-spawn.json",
          "/app/configs/rules/autoresearch/03-propose-to-execute.json",
          "/app/configs/rules/autoresearch/04a-execute-stamp-completion.json",
          "/app/configs/rules/autoresearch/04b-execute-stamp-failed.json",
          "/app/configs/rules/autoresearch/04c-execute-promote-best-on-kept.json",
          "/app/configs/rules/autoresearch/05-iteration-dispatch.json",
          "/app/configs/rules/autoresearch/07-synthesize-to-reviewer.json",
          "/app/configs/rules/autoresearch/08-reviewer-approved-to-coordinator.json",
          "/app/configs/rules/autoresearch/09-reviewer-rejected-resynthesize.json",
          "/app/configs/rules/autoresearch/10-needs-clarification-replan.json",
          "/app/configs/rules/autoresearch/11-loop-failed-pause.json",
          "/app/configs/rules/coordinator/03b-respond-direct.json",
          "/app/configs/rules/coordinator/03-ask-user.json"
        ],
        "inline_rules": []
      }
    },
    "teams-loop": {
      "type": "processor",
      "name": "agentic-loop",
      "enabled": true,
      "config": {
        "max_iterations": 8,
        "timeout": "60s",
        "stream_name": "AGENT",
        "loops_bucket": "AGENT_LOOPS",
        "consumer": {
          "ack_wait": "60s",
          "heartbeat_interval": "10s",
          "max_deliver": 2
        },
        "context": {
          "compact_threshold": 1.0,
          "headroom_ratio": 0.05,
          "headroom_tokens": 100
        },
        "ports": {
          "inputs": [
            {
              "name": "agent.task",
              "type": "jetstream",
              "subject": "agent.task.*",
              "stream_name": "AGENT",
              "required": true,
              "description": "Agent task requests"
            },
            {
              "name": "agent.response",
              "type": "jetstream",
              "subject": "agent.response.>",
              "stream_name": "AGENT",
              "required": true,
              "description": "Model responses"
            },
            {
              "name": "tool.result",
              "type": "jetstream",
              "subject": "tool.result.>",
              "stream_name": "TOOL",
              "required": true,
              "description": "Tool execution results"
            }
          ],
          "outputs": [
            {
              "name": "agent.request",
              "type": "jetstream",
              "subject": "agent.request.*",
              "stream_name": "AGENT",
              "description": "Model requests"
            },
            {
              "name": "tool.execute",
              "type": "jetstream",
              "subject": "tool.execute.*",
              "stream_name": "TOOL",
              "description": "Tool execution requests"
            },
            {
              "name": "agent.complete",
              "type": "jetstream",
              "subject": "agent.complete.*",
              "stream_name": "AGENT",
              "description": "Task completions"
            },
            {
              "name": "agent.failed",
              "type": "jetstream",
              "subject": "agent.failed.*",
              "stream_name": "AGENT",
              "description": "Loop failures — drives the chainpause subscriber (ADR-037 §D5 audit triples). Retires alongside chainpause in ADR-042 §Phase 6 migration cut; until then, declaring the port keeps the bootstrap canonical."
            }
          ],
          "kv_write": [
            {
              "name": "loops",
              "type": "kv-write",
              "bucket": "AGENT_LOOPS",
              "description": "Loop state storage"
            },
            {
              "name": "trajectories",
              "type": "kv-write",
              "bucket": "AGENT_TRAJECTORIES",
              "description": "Trajectory storage"
            }
          ]
        }
      }
    },
    "agentic-model": {
      "type": "processor",
      "name": "agentic-model",
      "enabled": true,
      "config": {
        "stream_name": "AGENT",
        "timeout": "30s",
        "_e2e_divergence": "retry.max_attempts: production bootstrap retries 3x; mock-llm is deterministic and fast — retries here would only mask fixture errors as transient failures. Retry-path coverage is out of scope for this MVP-5 journey; a separate spec can exercise it with a flake-injecting mock-llm fixture if needed.",
        "retry": {
          "max_attempts": 1,
          "backoff": "exponential"
        },
        "ports": {
          "inputs": [
            {
              "name": "agent.request",
              "type": "jetstream",
              "subject": "agent.request.>",
              "stream_name": "AGENT",
              "required": true,
              "description": "Agent request input"
            }
          ],
          "outputs": [
            {
              "name": "agent.response",
              "type": "jetstream",
              "subject": "agent.response.*",
              "stream_name": "AGENT",
              "required": true,
              "description": "Agent response output"
            }
          ]
        }
      }
    },
    "agentic-tools": {
      "type": "processor",
      "name": "agentic-tools",
      "enabled": true,
      "config": {
        "stream_name": "TOOL",
        "timeout": "10s",
        "allowed_tools": null,
        "ports": {
          "inputs": [
            {
              "name": "tool.execute",
              "type": "jetstream",
              "subject": "tool.execute.>",
              "stream_name": "TOOL",
              "required": true,
              "description": "Tool execution requests"
            }
          ],
          "outputs": [
            {
              "name": "tool.result",
              "type": "jetstream",
              "subject": "tool.result.*",
              "stream_name": "TOOL",
              "required": true,
              "description": "Tool execution results"
            }
          ],
          "kv_read": [
            {
              "name": "entity_states",
              "type": "kv-read",
              "bucket": "ENTITY_STATES",
              "description": "Entity state KV for graph queries"
            }
          ]
        }
      }
    },
    "oasf-generator": {
      "type": "processor",
      "name": "oasf-generator",
      "enabled": true,
      "config": {
        "entity_kv_bucket": "ENTITY_STATES",
        "oasf_kv_bucket": "OASF_RECORDS",
        "watch_pattern": ">",
        "generation_debounce": "500ms",
        "default_agent_version": "1.0.0",
        "default_authors": [
          "SemStreams"
        ],
        "include_extensions": true,
        "ports": {
          "inputs": [
            {
              "name": "entity_changes",
              "subject": "entity.state.>",
              "type": "kv-watch",
              "required": true,
              "description": "Watch for agent entity state changes"
            }
          ],
          "outputs": [
            {
              "name": "oasf_records",
              "subject": "oasf.record.generated.*",
              "type": "jetstream",
              "stream_name": "OASF",
              "required": true,
              "description": "Generated OASF records"
            }
          ],
          "kv_write": [
            {
              "name": "oasf_kv",
              "type": "kv-write",
              "bucket": "OASF_RECORDS",
              "description": "OASF record storage"
            }
          ]
        }
      }
    },
    "directory-bridge": {
      "type": "output",
      "name": "directory-bridge",
      "enabled": true,
      "config": {
        "directory_url": "http://localhost:8081",
        "heartbeat_interval": "30s",
        "registration_ttl": "5m",
        "identity_provider": "local",
        "oasf_kv_bucket": "OASF_RECORDS",
        "retry_count": 3,
        "retry_delay": "1s",
        "ports": {
          "inputs": [
            {
              "name": "oasf_records",
              "subject": "oasf.record.generated.>",
              "type": "kv-watch",
              "required": true,
              "description": "Watch for generated OASF records"
            }
          ],
          "outputs": [
            {
              "name": "registration_events",
              "subject": "directory.registration.*",
              "type": "jetstream",
              "stream_name": "DIRECTORY",
              "required": false,
              "description": "Registration events"
            }
          ]
        }
      }
    },
    "a2a-adapter": {
      "type": "input",
      "name": "a2a-adapter",
      "enabled": true,
      "config": {
        "transport": "http",
        "listen_address": ":8282",
        "agent_card_path": "/.well-known/agent.json",
        "request_timeout": "30s",
        "max_concurrent_tasks": 10,
        "enable_authentication": false,
        "oasf_bucket": "OASF_RECORDS",
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "name": "task_messages",
              "subject": "agent.task.a2a.*",
              "type": "jetstream",
              "stream_name": "AGENT",
              "required": true,
              "description": "Task messages to agent dispatch"
            }
          ]
        }
      }
    },
    "otel-exporter": {
      "type": "output",
      "name": "otel-exporter",
      "enabled": true,
      "config": {
        "endpoint": "http://localhost:4318",
        "protocol": "http",
        "service_name": "semstreams-agentic",
        "service_version": "1.0.0",
        "export_traces": true,
        "export_metrics": true,
        "export_logs": false,
        "batch_timeout": "2s",
        "max_batch_size": 100,
        "insecure": true,
        "sampling_rate": 1.0,
        "ports": {
          "inputs": [
            {
              "name": "agent_events",
              "subject": "agent.>",
              "type": "jetstream",
              "stream_name": "AGENT",
              "required": true,
              "description": "Agent lifecycle events for span collection"
            }
          ],
          "outputs": []
        }
      }
    },
    "teams-dispatch": {
      "type": "processor",
      "name": "agentic-dispatch",
      "enabled": true,
      "config": {
        "default_role": "coordinator",
        "auto_continue": true,
        "default_tools": ["decide", "read_loop_result", "scratchpad", "query_sandbox_attestation", "request_sandbox"],
        "stream_name": "USER",
        "ports": {
          "inputs": [
            {
              "name": "user.message",
              "type": "jetstream",
              "subject": "user.message.>",
              "stream_name": "USER",
              "required": true,
              "description": "User messages from any channel"
            },
            {
              "name": "agent.complete",
              "type": "jetstream",
              "subject": "agent.complete.*",
              "stream_name": "AGENT",
              "required": true,
              "description": "Loop completions — drives the coordinator's wake-up reply path"
            }
          ],
          "outputs": [
            {
              "name": "agent.task",
              "type": "jetstream",
              "subject": "agent.task.*",
              "stream_name": "AGENT",
              "description": "Task messages to agent loops"
            },
            {
              "name": "user.response",
              "type": "nats",
              "subject": "user.response.*",
              "description": "Responses back to users (fire-and-forget; channel routers fan out to UI/email/SMS)"
            }
          ]
        },
        "permissions": {
          "view": [
            "*"
          ],
          "submit_task": [
            "*"
          ],
          "cancel_own": true,
          "cancel_any": [],
          "approve": [
            "*"
          ]
        }
      }
    }
  }
}
