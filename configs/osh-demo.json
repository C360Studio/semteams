{
  "version": "1.1.0",
  "platform": {
    "org": "c360",
    "id": "semteams-osh-demo",
    "type": "agentic",
    "region": "local",
    "instance_id": "osh-demo-001",
    "environment": "demo"
  },
  "tier": "agentic",
  "nats": {
    "urls": ["nats://localhost:4222"]
  },
  "streams": {
    "USER": {
      "subjects": ["user.>"],
      "storage": "file",
      "max_age": "24h"
    },
    "GRAPH": {
      "subjects": [
        "graph.ingest.entity",
        "graph.ingest.batch",
        "graph.ingest.manifest",
        "graph.ingest.status",
        "graph.ingest.predicates"
      ],
      "storage": "file",
      "max_age": "24h"
    }
  },
  "model_registry": {
    "endpoints": {
      "gemini-pro": {
        "provider": "openai",
        "url": "https://generativelanguage.googleapis.com/v1beta/openai",
        "model": "gemini-2.5-pro",
        "api_key_env": "GEMINI_API_KEY",
        "max_tokens": 1048576,
        "supports_tools": true,
        "tool_format": "openai",
        "stream": false,
        "reasoning_effort": "low",
        "request_timeout": "300s"
      },
      "gemini-flash": {
        "provider": "openai",
        "url": "https://generativelanguage.googleapis.com/v1beta/openai",
        "model": "gemini-2.5-flash",
        "api_key_env": "GEMINI_API_KEY",
        "max_tokens": 1048576,
        "supports_tools": true,
        "tool_format": "openai",
        "stream": false,
        "reasoning_effort": "low",
        "request_timeout": "180s"
      },
      "claude-sonnet": {
        "provider": "anthropic",
        "url": "https://api.anthropic.com/v1",
        "model": "claude-sonnet-4-6",
        "api_key_env": "ANTHROPIC_API_KEY",
        "max_tokens": 200000,
        "max_output_tokens": 64000,
        "supports_tools": true,
        "stream": true,
        "reasoning_effort": "low",
        "request_timeout": "300s",
        "max_concurrent": 4,
        "requests_per_minute": 100
      },
      "claude-haiku": {
        "provider": "anthropic",
        "url": "https://api.anthropic.com/v1",
        "model": "claude-haiku-4-5-20251001",
        "api_key_env": "ANTHROPIC_API_KEY",
        "max_tokens": 200000,
        "max_output_tokens": 32000,
        "supports_tools": true,
        "stream": true,
        "request_timeout": "300s",
        "max_concurrent": 4,
        "requests_per_minute": 200
      },
      "seminstruct": {
        "provider": "openai",
        "url": "http://seminstruct:8083/v1",
        "model": "qwen3-8b",
        "max_tokens": 32768,
        "max_output_tokens": 4096,
        "supports_tools": true,
        "tool_format": "openai",
        "stream": true,
        "request_timeout": "120s",
        "max_concurrent": 4
      },
      "semembed": {
        "provider": "openai",
        "url": "http://semembed:8081/v1",
        "model": "Snowflake/snowflake-arctic-embed-s",
        "max_tokens": 0,
        "supports_tools": false,
        "request_timeout": "30s",
        "max_concurrent": 8
      }
    },
    "defaults": {
      "model": "gemini-pro",
      "capability": "general"
    },
    "capabilities": {
      "general":               { "preferred": ["gemini-pro"], "fallback": ["claude-sonnet", "gemini-flash"], "requires_tools": true },
      "planning":              { "preferred": ["gemini-pro"], "fallback": ["claude-sonnet", "gemini-flash"], "requires_tools": true },
      "architecture":          { "preferred": ["gemini-pro"], "fallback": ["claude-sonnet", "gemini-flash"], "requires_tools": true },
      "qa":                    { "preferred": ["gemini-pro"], "fallback": ["claude-sonnet", "gemini-flash"], "requires_tools": true },
      "reviewing":             { "preferred": ["claude-sonnet"], "fallback": ["gemini-pro", "gemini-flash"], "requires_tools": true },
      "coding":                { "preferred": ["claude-sonnet"], "fallback": ["gemini-pro"], "requires_tools": true },
      "embedding":             { "preferred": ["semembed"] },
      "community_summary":     { "preferred": ["seminstruct"] },
      "anomaly_review":        { "preferred": ["seminstruct"] },
      "summarization":         { "preferred": ["seminstruct"] },
      "query_classification":  { "preferred": ["seminstruct"] },
      "answer_synthesis":      { "preferred": ["seminstruct"] },
      "intent_classification": { "preferred": ["seminstruct"] },
      "layer_normalization":   { "preferred": ["seminstruct"] }
    }
  },
  "services": {
    "service-manager": {
      "name": "service-manager",
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemTeams OSH Demo (R3.4)",
          "description": "R3.4 of ADR-031, extended for R3.7.2.l′ smoke #7 of ADR-034: real-LLM end-to-end run of the OSH-class arc through the qa-reviewer terminal. Builds on R3.3's dev-via-spec chain + R3.7.2.k′'s post-build review hop. Eleven rules: research-mode-transition (01a/01b/02/03) + dev-via-spec (01-07). Hybrid model routing per semspec evidence (configs/e2e-hybrid.json, run-data 2026-05): gemini-pro for heavy reasoning (research, planning, architecture, decomposition, qa) — gemini's higher per-key throughput + non-saturated tier carry the chain's bulk; claude-sonnet reserved for code-generation and code-review (the builder + reviewer/challenger roles where sonnet is empirically strongest). Smoke #7 run-2 (2026-05-05) timed out a single 180s sonnet completion after Loop A consumed ~423k input tokens — strong signal that routing the heavy researcher through sonnet is the wrong shape. Internal-graph capabilities (community_summary, anomaly_review, summarization, query_classification, embedding, intent_classification, layer_normalization, answer_synthesis) stay on local seminstruct/semembed — async background work shouldn't pay cloud tokens, and graph-persisting capabilities are on qwen3-8b to avoid garbage in the substrate. SemSource, local-models, and sandbox compose profiles required. Note: the spawn-rule for dev-via-spec-qa-reviewer (rule 07) embeds a literal '(stub)' evidence_summary block per R3.7.2.k′; the qa-reviewer's persona-correct verdict against stubbed evidence is decide(needs_clarification). Real evidence-summary plumbing is the open work surfaced by this smoke; see project_smoke7_open_plumbing.md §2. Requires GEMINI_API_KEY and ANTHROPIC_API_KEY.",
          "version": "1.0.0"
        }
      }
    },
    "component-manager": {
      "name": "component-manager",
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "name": "metrics",
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics",
        "include_go_metrics": true
      }
    },
    "message-logger": {
      "name": "message-logger",
      "enabled": true,
      "config": {
        "max_entries": 50000,
        "monitor_subjects": [
          "agent.>",
          "tool.>",
          "user.>",
          "graph.mutation.>",
          "graph.ingest.>",
          "research.artifact.>",
          "dev_via_spec.artifact.>",
          "dev_via_spec.plan.>",
          "dev_via_spec.consensus.>"
        ],
        "enable_kv_query": true,
        "log_level": "INFO"
      }
    }
  },
  "components": {
    "teams-dispatch": {
      "type": "processor",
      "name": "agentic-dispatch",
      "enabled": true,
      "config": {
        "default_role": "researcher",
        "default_tools": ["read_loop_result", "query_entity", "query_entities", "emit_research_artifact"],
        "auto_continue": false,
        "stream_name": "USER",
        "permissions": {
          "submit_task": ["*"],
          "view": ["*"],
          "approve": ["*"]
        },
        "ports": {
          "inputs": [
            {"name": "user.message", "type": "jetstream", "subject": "user.message.>", "stream_name": "USER", "required": true, "description": "User messages from any channel"},
            {"name": "agent.complete", "type": "jetstream", "subject": "agent.complete.*", "stream_name": "AGENT", "required": true, "description": "Agent completion events"}
          ],
          "outputs": [
            {"name": "agent.task", "type": "jetstream", "subject": "agent.task.*", "stream_name": "AGENT", "description": "Task submissions to agent loop"},
            {"name": "user.response", "type": "nats", "subject": "user.response.*", "description": "Responses back to users"}
          ]
        }
      }
    },
    "teams-loop": {
      "type": "processor",
      "name": "agentic-loop",
      "enabled": true,
      "config": {
        "max_iterations": 100,
        "timeout": "1200s",
        "stream_name": "AGENT",
        "loops_bucket": "AGENT_LOOPS",
        "consumer": {
          "ack_wait": "1230s",
          "heartbeat_interval": "30s",
          "max_deliver": 2
        },
        "context": {
          "compact_threshold": 0.85,
          "headroom_ratio": 0.1,
          "headroom_tokens": 4096
        },
        "ports": {
          "inputs": [
            {"name": "agent.task", "type": "jetstream", "subject": "agent.task.*", "stream_name": "AGENT", "required": true},
            {"name": "agent.response", "type": "jetstream", "subject": "agent.response.>", "stream_name": "AGENT", "required": true},
            {"name": "tool.result", "type": "jetstream", "subject": "tool.result.>", "stream_name": "TOOL", "required": true}
          ],
          "outputs": [
            {"name": "agent.request", "type": "jetstream", "subject": "agent.request.*", "stream_name": "AGENT"},
            {"name": "tool.execute", "type": "jetstream", "subject": "tool.execute.*", "stream_name": "TOOL"},
            {"name": "agent.complete", "type": "jetstream", "subject": "agent.complete.*", "stream_name": "AGENT"}
          ],
          "kv_write": [
            {"name": "loops", "type": "kv-write", "bucket": "AGENT_LOOPS"},
            {"name": "trajectories", "type": "kv-write", "bucket": "AGENT_TRAJECTORIES"}
          ]
        }
      }
    },
    "agentic-model": {
      "type": "processor",
      "name": "agentic-model",
      "enabled": true,
      "config": {
        "stream_name": "AGENT",
        "timeout": "310s",
        "consumer": {
          "ack_wait": "330s",
          "heartbeat_interval": "30s"
        },
        "retry": {
          "max_attempts": 3,
          "backoff": "exponential"
        },
        "ports": {
          "inputs": [
            {"name": "agent.request", "type": "jetstream", "subject": "agent.request.>", "stream_name": "AGENT", "required": true}
          ],
          "outputs": [
            {"name": "agent.response", "type": "jetstream", "subject": "agent.response.*", "stream_name": "AGENT", "required": true}
          ]
        }
      }
    },
    "agentic-tools": {
      "type": "processor",
      "name": "agentic-tools",
      "enabled": true,
      "config": {
        "stream_name": "TOOL",
        "timeout": "60s",
        "allowed_tools": [
          "read_loop_result",
          "query_entity",
          "query_entities",
          "query_relationships",
          "query_neighbors",
          "query_by_type",
          "list_components",
          "web_search",
          "http_request",
          "decide",
          "add_source_repo",
          "emit_research_artifact",
          "emit_curator_artifact",
          "emit_plan",
          "emit_consensus",
          "emit_dev_via_spec_artifact",
          "bootstrap_workspace",
          "bash",
          "builder_decide",
          "emit_diagnosis",
          "submit_work",
          "write_todos"
        ],
        "approval_required": ["add_source_repo"],
        "ports": {
          "inputs": [
            {"name": "tool.execute", "type": "jetstream", "subject": "tool.execute.>", "stream_name": "TOOL", "required": true}
          ],
          "outputs": [
            {"name": "tool.result", "type": "jetstream", "subject": "tool.result.*", "stream_name": "TOOL", "required": true}
          ],
          "kv_read": [
            {"name": "entity_states", "type": "kv-read", "bucket": "ENTITY_STATES"}
          ]
        }
      }
    },
    "rule-processor": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "rules_files": [
          "/app/configs/rules/chain/00-loop-failed-pause.json",
          "/app/configs/rules/research-mode-transition/01a-research-to-reviewer-after-researcher.json",
          "/app/configs/rules/research-mode-transition/02-reviewer-rejected-spawn-curator.json",
          "/app/configs/rules/research-mode-transition/02b-curator-indexed-to-researcher.json",
          "/app/configs/rules/research-mode-transition/02c-curator-needs-clarification-to-researcher.json",
          "/app/configs/rules/research-mode-transition/03-stabilise-and-transition.json",
          "/app/configs/rules/dev-via-spec/01-planner-to-reviewer.json",
          "/app/configs/rules/dev-via-spec/02-reviewer-rejected-retry-planner.json",
          "/app/configs/rules/dev-via-spec/03-reviewer-approved-to-challenger.json",
          "/app/configs/rules/dev-via-spec/04-challenger-concerns-retry-planner.json",
          "/app/configs/rules/dev-via-spec/05-challenger-accept-to-architect.json",
          "/app/configs/rules/dev-via-spec/06-architect-emit-to-builder.json",
          "/app/configs/rules/dev-via-spec/07-builder-decide-to-qa-reviewer.json",
          "/app/configs/rules/ops/chain-terminal-observe.json"
        ],
        "enable_graph_integration": true,
        "entity_watch_buckets": {
          "ENTITY_STATES": [">"]
        },
        "ports": {
          "inputs": [
            {"name": "entity_states", "subject": "ENTITY_STATES.>", "type": "kv-watch", "bucket": "ENTITY_STATES"}
          ],
          "outputs": [
            {"name": "agent.task", "subject": "agent.task.*", "type": "jetstream", "stream_name": "AGENT", "description": "Spawn agents from rules"},
            {"name": "graph.mutation", "subject": "graph.mutation.*", "type": "nats", "description": "Graph triple mutations"}
          ]
        }
      }
    },
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "enable_hierarchy": true,
        "ports": {
          "inputs": [
            {"name": "graph_mutations", "subject": "graph.mutation.>", "type": "nats"},
            {"name": "entities_in", "subject": "graph.ingest.entity", "type": "jetstream", "stream_name": "GRAPH"}
          ],
          "outputs": [
            {"name": "entity_states", "subject": "ENTITY_STATES", "type": "kv-write"}
          ]
        }
      }
    },
    "graph-query": {
      "type": "processor",
      "name": "graph-query",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {"name": "query_requests", "subject": "graph.query.>", "type": "nats-request"}
          ],
          "outputs": []
        },
        "request_timeout": "30s",
        "max_traversal_depth": 5,
        "max_traversal_nodes": 100
      }
    }
  }
}
