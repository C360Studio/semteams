{
  "version": "1.1.0",
  "platform": {
    "org": "c360",
    "id": "semteams-bootstrap",
    "type": "bootstrap",
    "region": "local",
    "instance_id": "bootstrap-001",
    "environment": "development"
  },
  "tier": "agentic",
  "nats": {
    "urls": [
      "nats://localhost:4222"
    ]
  },
  "streams": {
    "USER": {
      "subjects": ["user.>"],
      "storage": "file",
      "max_age": "1h",
      "max_bytes": 67108864,
      "discard": "old"
    },
    "AGENT": {
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    },
    "TOOL": {
      "max_age": "24h",
      "max_bytes": 268435456,
      "discard": "old"
    }
  },
  "model_registry": {
    "endpoints": {
      "claude-haiku": {
        "provider": "anthropic",
        "url": "https://api.anthropic.com/v1",
        "model": "claude-haiku-4-5-20251001",
        "api_key_env": "ANTHROPIC_API_KEY",
        "max_tokens": 200000,
        "supports_tools": true,
        "stream": true,
        "max_concurrent": 10,
        "requests_per_minute": 200
      },
      "claude-sonnet": {
        "provider": "anthropic",
        "url": "https://api.anthropic.com/v1",
        "model": "claude-sonnet-4-6",
        "api_key_env": "ANTHROPIC_API_KEY",
        "max_tokens": 200000,
        "supports_tools": true,
        "stream": true,
        "reasoning_effort": "low",
        "max_concurrent": 10,
        "requests_per_minute": 100
      },
      "gemini-flash": {
        "_comment": "Gemini 3 Flash Preview via the framework-owned wire client (provider=gemini + wire_backend=wire engages GeminiAdapter for thought_signature capture). Aligned with semstreams' canonical gemini-example.json + PR #196's hardened live test shape: stream=false (we have no UI consuming SSE chunks; the coordinator reads the full completion before deciding, and streaming may drop tool_call extra_content on chunk boundaries — the smoke-#13 #194 zero-sigs anomaly reproduced 2026-06-02 with stream=true and the framework's capture path stored 0 ReasoningRecords). reasoning_effort omitted to take the framework default; max_tokens at the model max.",
        "provider": "gemini",
        "url": "https://generativelanguage.googleapis.com/v1beta/openai",
        "model": "gemini-3-flash-preview",
        "api_key_env": "GEMINI_API_KEY",
        "wire_backend": "wire",
        "max_tokens": 1048576,
        "supports_tools": true,
        "tool_format": "openai",
        "stream": false,
        "request_timeout": "180s",
        "max_concurrent": 5,
        "requests_per_minute": 100
      },
      "gemini-pro": {
        "_comment": "Gemini 3.1 Pro Preview — provider=gemini + wire_backend=wire engages GeminiAdapter for thought_signature capture. Aligned with semstreams' canonical gemini-example.json + PR #196's hardened live test (stream=false). The 2026-06-01 flip to stream=true (citing 'semspec working config') was reverted 2026-06-02 after smoke-#13 #194 zero-sigs reproduced under stream=true and upstream's PR #196 live test demonstrated the contract works with stream=false. We get no value from streaming in our use case (no UI consuming SSE chunks; the coordinator reads the full completion before deciding) and streaming may drop tool_call extra_content on chunk boundaries.",
        "provider": "gemini",
        "url": "https://generativelanguage.googleapis.com/v1beta/openai",
        "model": "gemini-3.1-pro-preview",
        "api_key_env": "GEMINI_API_KEY",
        "wire_backend": "wire",
        "tool_format": "openai",
        "request_timeout": "180s",
        "max_tokens": 1048576,
        "supports_tools": true,
        "stream": false,
        "max_concurrent": 5,
        "requests_per_minute": 100
      }
    },
    "defaults": {
      "_comment": "Endpoint name (validator enforced). agentic-model's resolveEndpoint walks GetFallbackChain(req.Model) first, but req.Model is set by agentic-dispatch.resolveModel() which returns GetDefault() verbatim — and defaults.model MUST be an endpoint per the registry validator (model/registry.go:396). Capability-chain semantics for HTTP-dispatched coordinator are unreachable upstream-as-shipped (smoke #13 run-2 finding 2026-06-02): rule-pack publish_agent actions are the only way capabilities fire. gemini-flash chosen here over gemini-pro for cost; the 51→5 tool fix (beta.92) + wire-layer alignment (provider=gemini + wire_backend=wire + 3-flash-preview) above should let the smaller model handle the coordinator persona.",
      "model": "gemini-flash"
    },
    "capabilities": {
      "coordinator": { "preferred": ["gemini-pro"], "fallback": ["gemini-flash", "claude-haiku"], "requires_tools": true },
      "research": { "preferred": ["gemini-flash"], "fallback": ["claude-haiku"], "requires_tools": true },
      "reviewing": { "preferred": ["gemini-flash"], "fallback": ["claude-haiku"], "requires_tools": true },
      "general": { "preferred": ["gemini-flash"], "fallback": ["claude-haiku"], "requires_tools": true }
    }
  },
  "services": {
    "service-manager": {
      "name": "service-manager",
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemTeams Bootstrap",
          "description": "Substrate-singleton boot config per ADR-042 §Phase 2 redesign + ADR-043 (devcontainer.json sandbox model). Agentic + graph + rule-processor components run as singletons; task-category rule packs (research, autoresearch) and named persona bundles run through them. Sandbox provisioning is synchronous via the request_sandbox tool (ADR-043 three-layer model) — no separate sandbox-bootstrap rule pack. Research pack is fully functional.",
          "version": "0.8.0"
        }
      }
    },
    "component-manager": {
      "name": "component-manager",
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "name": "metrics",
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics",
        "include_go_metrics": true
      }
    },
    "message-logger": {
      "name": "message-logger",
      "enabled": true,
      "config": {
        "max_entries": 10000,
        "monitor_subjects": [
          "agent.>",
          "tool.>",
          "user.>",
          "graph.mutation.>"
        ],
        "enable_kv_query": true,
        "log_level": "INFO"
      }
    },
    "log-forwarder": {
      "name": "log-forwarder",
      "enabled": true,
      "config": {
        "min_level": "DEBUG",
        "exclude_sources": []
      }
    },
    "metrics-forwarder": {
      "name": "metrics-forwarder",
      "enabled": true,
      "config": {
        "push_interval": "5s",
        "include_go_metrics": false,
        "include_proc_metrics": false
      }
    }
  },
  "components": {
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "graph_mutations",
              "subject": "graph.mutation.>",
              "type": "nats",
              "description": "Triple add/remove mutations from agent emit tools, rules, and operator-side subscribers"
            }
          ],
          "outputs": [
            {
              "name": "entity_states",
              "subject": "ENTITY_STATES",
              "type": "kv-write",
              "description": "Entity state KV bucket"
            }
          ]
        },
        "enable_hierarchy": true,
        "enforce_owner_lease": true
      }
    },
    "graph-query": {
      "type": "processor",
      "name": "graph-query",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {"name": "query_requests", "subject": "graph.query.>", "type": "nats-request"}
          ],
          "outputs": []
        },
        "request_timeout": "30s",
        "max_traversal_depth": 5,
        "max_traversal_nodes": 100
      }
    },
    "rule": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "entity_watch_buckets": {
          "ENTITY_STATES": ["c360.*.*.*.*.*"]
        },
        "ports": {
          "inputs": [
            {
              "name": "entity_states",
              "subject": "ENTITY_STATES.>",
              "type": "kv-watch",
              "bucket": "ENTITY_STATES",
              "description": "Entity state changes drive rule evaluation. Rule conditions resolve against entity facts (agent.loop.role, coordinator.decision.next-action, etc.), not raw NATS messages — the message-path evaluator can't bind entity-typed predicates."
            }
          ],
          "outputs": [
            {
              "name": "agent_task",
              "subject": "agent.task.*",
              "type": "jetstream",
              "stream_name": "AGENT",
              "description": "Agent task triggers from rules"
            },
            {
              "name": "graph_mutation",
              "subject": "graph.mutation.*",
              "type": "nats",
              "description": "Graph triple mutations from rule add_triple actions"
            }
          ]
        },
        "enable_graph_integration": true,
        "pack_id": "semteams",
        "projection_contracts": [
          {
            "name": "autoresearch.run-projection",
            "entity_pattern": "*.*.agent.chain.execution.*",
            "groups": [
              {
                "name": "run-state",
                "mode": "replace-owned",
                "predicates": [
                  "autoresearch.best.value",
                  "autoresearch.best.experiment-id",
                  "autoresearch.run.status",
                  "autoresearch.iteration.pending"
                ]
              }
            ]
          }
        ],
        "rules_files": [
          "/app/configs/rules/research/01-coordinator-research-spawn.json",
          "/app/configs/rules/research/02-plan-to-gather.json",
          "/app/configs/rules/research/03a-gather-stamp-completion-on-plan.json",
          "/app/configs/rules/research/03b-synthesize-when-all-gathers-complete.json",
          "/app/configs/rules/research/04-synthesize-to-reviewer.json",
          "/app/configs/rules/research/05-reviewer-rejected-retry.json",
          "/app/configs/rules/research/06-needs-clarification-replan.json",
          "/app/configs/rules/research/07-reviewer-approved-to-coordinator.json",
          "/app/configs/rules/research/08-loop-failed-pause.json",
          "/app/configs/rules/research/09-loop-failed-run-outcome.json",
          "/app/configs/rules/autoresearch/01-coordinator-autoresearch-spawn.json",
          "/app/configs/rules/autoresearch/03-propose-to-execute.json",
          "/app/configs/rules/autoresearch/04a-execute-stamp-completion.json",
          "/app/configs/rules/autoresearch/04b-execute-stamp-failed.json",
          "/app/configs/rules/autoresearch/04c-execute-promote-best-on-kept.json",
          "/app/configs/rules/autoresearch/05-iteration-dispatch.json",
          "/app/configs/rules/autoresearch/07-synthesize-to-reviewer.json",
          "/app/configs/rules/autoresearch/08-reviewer-approved-to-coordinator.json",
          "/app/configs/rules/autoresearch/09-reviewer-rejected-resynthesize.json",
          "/app/configs/rules/autoresearch/10-needs-clarification-replan.json",
          "/app/configs/rules/autoresearch/10b-descended-needs-clarification-replan.json",
          "/app/configs/rules/autoresearch/11-loop-failed-pause.json",
          "/app/configs/rules/autoresearch/12-baseline-loop-failed-run-outcome.json",
          "/app/configs/rules/autoresearch/13-loop-failed-run-outcome.json",
          "/app/configs/rules/coordinator/03b-respond-direct.json",
          "/app/configs/rules/coordinator/03-ask-user.json",
          "/app/configs/rules/agent-run/01-handoff-marker.json",
          "/app/configs/rules/agent-run/01b-handoff-marker-redispatch.json",
          "/app/configs/rules/agent-run/02-dispatched-to-executing.json",
          "/app/configs/rules/agent-run/03-executing-to-completed.json",
          "/app/configs/rules/agent-run/04-executing-to-failed.json",
          "/app/configs/rules/agent-run/05-coordinator-failed-run-anchor.json",
          "/app/configs/rules/agent-run/06-coordinator-failed-lineage-anchor.json",
          "/app/configs/rules/agent-run/07-ask-user-pause-run-anchor.json",
          "/app/configs/rules/agent-run/08-ask-user-pause-lineage-anchor.json",
          "/app/configs/rules/agent-run/09-executing-to-awaiting-on-clarification.json",
          "/app/configs/rules/agent-run/10-clarification-reply-resume-marker.json",
          "/app/configs/rules/agent-run/11-resume-awaiting-to-executing.json",
          "/app/configs/rules/agent-run/12-executing-to-awaiting-on-approval.json",
          "/app/configs/rules/agent-run/13-resume-awaiting-to-executing-on-approval.json"
        ],
        "inline_rules": []
      }
    },
    "teams-loop": {
      "type": "processor",
      "name": "agentic-loop",
      "enabled": true,
      "config": {
        "max_iterations": 50,
        "timeout": "300s",
        "stream_name": "AGENT",
        "loops_bucket": "AGENT_LOOPS",
        "ports": {
          "inputs": [
            {
              "name": "agent.task",
              "type": "jetstream",
              "subject": "agent.task.*",
              "stream_name": "AGENT",
              "required": true,
              "description": "Agent task requests"
            },
            {
              "name": "agent.response",
              "type": "jetstream",
              "subject": "agent.response.>",
              "stream_name": "AGENT",
              "required": true,
              "description": "Model responses"
            },
            {
              "name": "tool.result",
              "type": "jetstream",
              "subject": "tool.result.>",
              "stream_name": "TOOL",
              "required": true,
              "description": "Tool execution results"
            },
            {
              "name": "agent.approval_response",
              "type": "jetstream",
              "subject": "agent.approval_response.*",
              "stream_name": "AGENT",
              "description": "Human approve/reject/modify decisions (ADR-053 §4c PR-2). The loop's setupSubscriptions routes this port to handleApprovalResponseMessage → ResolveApprovalIfPending, which un-parks the gated loop. WITHOUT this declared input the loop never subscribes and can NEVER resume from an approval gate. Also drives the approvalpause subscriber's run-phase resume marker. (Prod sets no approval_required today, so the gate is inert here; the port keeps the bootstrap canonical and ready if an operator gates a tool.)"
            }
          ],
          "outputs": [
            {
              "name": "agent.request",
              "type": "jetstream",
              "subject": "agent.request.*",
              "stream_name": "AGENT",
              "description": "Model requests"
            },
            {
              "name": "tool.execute",
              "type": "jetstream",
              "subject": "tool.execute.*",
              "stream_name": "TOOL",
              "description": "Tool execution requests"
            },
            {
              "name": "agent.complete",
              "type": "jetstream",
              "subject": "agent.complete.*",
              "stream_name": "AGENT",
              "description": "Task completions"
            },
            {
              "name": "agent.failed",
              "type": "jetstream",
              "subject": "agent.failed.*",
              "stream_name": "AGENT",
              "description": "Loop failures — drives the chainpause subscriber (ADR-037 §D5 audit triples). Retires alongside chainpause in ADR-042 §Phase 6 migration cut; until then, declaring the port keeps the bootstrap canonical."
            },
            {
              "name": "agent.approval_pending",
              "type": "jetstream",
              "subject": "agent.approval_pending.*",
              "stream_name": "AGENT",
              "description": "Tool-gate approval-pending events — drives the approvalpause subscriber (ADR-053 §4c: run-phase reflection of the loop-level approval_required gate). Declaring the port keeps the subject covered by the AGENT stream so PublishToStream succeeds and lets portresolver resolve the subscribe subject."
            }
          ],
          "kv_write": [
            {
              "name": "loops",
              "type": "kv-write",
              "bucket": "AGENT_LOOPS",
              "description": "Loop state storage"
            },
            {
              "name": "trajectories",
              "type": "kv-write",
              "bucket": "AGENT_TRAJECTORIES",
              "description": "Trajectory storage"
            }
          ]
        }
      }
    },
    "agentic-model": {
      "type": "processor",
      "name": "agentic-model",
      "enabled": true,
      "config": {
        "stream_name": "AGENT",
        "timeout": "30s",
        "retry": {
          "max_attempts": 3,
          "backoff": "exponential"
        },
        "ports": {
          "inputs": [
            {
              "name": "agent.request",
              "type": "jetstream",
              "subject": "agent.request.>",
              "stream_name": "AGENT",
              "required": true,
              "description": "Agent request input"
            }
          ],
          "outputs": [
            {
              "name": "agent.response",
              "type": "jetstream",
              "subject": "agent.response.*",
              "stream_name": "AGENT",
              "required": true,
              "description": "Agent response output"
            }
          ]
        }
      }
    },
    "agentic-tools": {
      "type": "processor",
      "name": "agentic-tools",
      "enabled": true,
      "config": {
        "stream_name": "TOOL",
        "timeout": "10s",
        "allowed_tools": null,
        "restricted_decide_actions": [],
        "ports": {
          "inputs": [
            {
              "name": "tool.execute",
              "type": "jetstream",
              "subject": "tool.execute.>",
              "stream_name": "TOOL",
              "required": true,
              "description": "Tool execution requests"
            }
          ],
          "outputs": [
            {
              "name": "tool.result",
              "type": "jetstream",
              "subject": "tool.result.*",
              "stream_name": "TOOL",
              "required": true,
              "description": "Tool execution results"
            }
          ],
          "kv_read": [
            {
              "name": "entity_states",
              "type": "kv-read",
              "bucket": "ENTITY_STATES",
              "description": "Entity state KV for graph queries"
            }
          ]
        }
      }
    },
    "teams-dispatch": {
      "type": "processor",
      "name": "agentic-dispatch",
      "enabled": true,
      "config": {
        "default_role": "coordinator",
        "auto_continue": true,
        "default_tools": ["decide", "read_loop_result", "scratchpad", "query_sandbox_attestation", "request_sandbox", "query_entity"],
        "stream_name": "USER",
        "ports": {
          "inputs": [
            {
              "name": "user.message",
              "type": "jetstream",
              "subject": "user.message.>",
              "stream_name": "USER",
              "required": true,
              "description": "User messages from any channel"
            },
            {
              "name": "agent.complete",
              "type": "jetstream",
              "subject": "agent.complete.*",
              "stream_name": "AGENT",
              "required": true,
              "description": "Loop completions — drives the coordinator's wake-up reply path"
            }
          ],
          "outputs": [
            {
              "name": "agent.task",
              "type": "jetstream",
              "subject": "agent.task.*",
              "stream_name": "AGENT",
              "description": "Task messages to agent loops"
            },
            {
              "name": "user.response",
              "type": "nats",
              "subject": "user.response.*",
              "description": "Responses back to users (fire-and-forget; channel routers fan out to UI/email/SMS)"
            },
            {
              "name": "agent.approval_response",
              "type": "jetstream",
              "subject": "agent.approval_response.*",
              "stream_name": "AGENT",
              "description": "Approve/reject/modify decisions published by POST /teams-dispatch/loops/{id}/approval (ADR-053 §4c PR-2). Declared so PublishToStream is AGENT-stream-covered, ResolveSubject resolves the subject, and the AGENT stream carries agent.approval_response.* for the teams-loop consumer + the approvalpause resume subscriber."
            }
          ]
        },
        "permissions": {
          "view": [
            "*"
          ],
          "submit_task": [
            "*"
          ],
          "cancel_own": true,
          "cancel_any": [],
          "approve": [
            "*"
          ]
        }
      }
    }
  }
}
